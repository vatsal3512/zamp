# Comma-separated Gemini API keys (rotated on quota errors)
GEMINI_API_KEYS=
# Comma-separated, ordered model chain (set from scripts/check-models.ts + bake-off)
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Neon Postgres connection string
DATABASE_URL=
# Ask Gemini for field bounding boxes (enable only if the Day-2 bake-off passes)
EXTRACT_BOXES=false
# Optional: Neon branch used by DB integration tests
TEST_DATABASE_URL=
